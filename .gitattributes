# GitHub Linguist Configuration for BeatGem (Rust + WGSL Desktop Application)
# Note: Use -linguist-vendored (hyphen prefix) to explicitly un-vendor Rust and WGSL files.
*.rs -linguist-vendored linguist-detectable=true
*.wgsl -linguist-vendored linguist-detectable=true

# Exclude all TypeScript, HTML, CSS, and JSON web preview wrapper files from GitHub language statistics
*.ts linguist-vendored
*.tsx linguist-vendored
*.js linguist-vendored
*.jsx linguist-vendored
*.html linguist-vendored
*.css linguist-vendored
*.json linguist-vendored
*.md linguist-documentation
src/* linguist-vendored
src/** linguist-vendored
public/* linguist-vendored
public/** linguist-vendored
